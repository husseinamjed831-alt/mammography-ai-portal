      "name": "تجهيز الطلب",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const f = $json;\nconst themes = {\"كلاسيكي عراقي (إطار)\": \"classic\", \"طبي\": \"medical\", \"هندسي\": \"engineering\", \"علوم\": \"science\", \"قانوني\": \"law\", \"أدبي وإنساني\": \"humanities\", \"إداري واقتصادي\": \"business\", \"بسيط أنيق\": \"minimal\"};\nreturn [{ json: {\n  title: f['عنوان التقرير'],\n  student: f['اسم الطالب'],\n  university: f['الجامعة'],\n  college: f['الكلية'],\n  department: f['القسم'] || '',\n  subject: f['المادة'],\n  stage: f['المرحلة'],\n  supervisor: f['اسم الأستاذ المشرف'] || '',\n  academic_year: f['العام الدراسي'] || '',\n  lang: f['لغة التقرير'] === 'English' ? 'en' : 'ar',\n  pages: Math.min(Math.max(Number(f['عدد الصفحات']) || 10, 5), 40),\n  theme: themes[f['التصميم']] || 'classic',\n  level: f['المستوى'] === 'دراسات عليا' ? 'postgraduate' : 'undergraduate',\n  citation: f['نمط التوثيق'] || 'APA 7',\n  notes: f['ملاحظات الأستاذ أو نقاط يجب التركيز عليها'] || '',\n  kind: 'report'\n}}];"
      }
    },

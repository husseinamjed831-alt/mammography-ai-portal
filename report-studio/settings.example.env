# انسخ هذا الملف باسم settings.env واملأ القيم (بدون مسافات حول =)

# التوكن من BotFather
TELEGRAM_BOT_TOKEN=

# منو يكتب التقارير: gemini (مجاني للبداية) أو claude (مدفوع)
AI_PROVIDER=gemini

# مفتاح Gemini من aistudio.google.com
GEMINI_API_KEY=

# مفتاح Claude من console.anthropic.com (إذا AI_PROVIDER=claude)
ANTHROPIC_API_KEY=

# اختياري: اسم الموديل. إذا Gemini گال إن الموديل مو موجود، جرب gemini-2.5-flash
# STUDIO_MODEL=

# رقمك بتيليگرام: شغّل البوت واكتب له /id ثم حطه هنا وأعد التشغيل
ADMIN_CHAT_ID=

# تعليمات الدفع اللي تطلع للطالب
PAYMENT_INFO=حوّل المبلغ على زين كاش للرقم 07XXXXXXXXX ثم دز صورة الوصل هنا 👇

# زر تواصل معنا
CONTACT_INFO=للتواصل: @YourUsername
